---
import '../styles/index.css';
import { Image } from 'astro:assets';
const siteTitle = "Stonehenge Steel UK Ltd";


import tubeImg from '../assets/stainless-steel-welded-pipe.jpg';
import barImg from '../assets/Bar-stock-1-scaled.jpg';
import pipeImg from '../assets/pipe.jpeg';
import sheetPlateImg from '../assets/sheetPlate.jpg';
import hygienicImg from '../assets/hygienic.jpg';
import additionalImg from '../assets/additional.jpg';
import SHLogo from '../assets/StoneHenge-Steel-logo-animation-for-website-no-BG.gif';
import SHLogoText from '../assets/Stonehenge-logo.png';

import Layout from '../layouts/Layout.astro';

const products = [
  {
    title: "Bar",
    description: "Premium stainless, mild, engineering, and aluminum bar stock. Available in round, flat, square, hex, and angle forms for varied applications.",
    image: barImg,
    link: "/bar"
  },
  {
    title: "Tube",
    description: "Stainless, mild, and aluminum welded structural and decorative tubes. Ideal for tube bending, swaging, flaring, and precise structural work.",
    image: tubeImg,
    link: "/tube"
  },
  {
    title: "Sheet & Plate",
    description: "Hot rolled, cold rolled, tread plates, and perforated sheets in stainless steel, mild steel, and aluminum across various sizes and finishes.",
    image: sheetPlateImg,
    link: "/sheet-plate"
  },
  {
    title: "Pipe",
    description: "Welded and seamless pipes to ASTM/ANSI standards. Includes butt weld fittings, flanges, and high-pressure 3000lb threaded fittings.",
    image: pipeImg,
    link: "/pipe"
  },
  {
    title: "Hygienic Tube & Fittings",
    description: "High-purity ASTM A270 and DIN 11850 tubes in bright annealed and satin polished finishes, designed specifically for sensitive applications.",
    image: hygienicImg,
    link: "/hygienic"
  },
  {
    title: "Additional Products",
    description: "Walkway grating, woven/welded mesh, expanded metal, precision tubes, mandrel bent elbows, and carbon pipes.",
    image: additionalImg,
    link: "/additional"
  }
];
---


<html lang="en">
<Layout title="Home">
  <!-- Dynamic Carousel Hero Section -->
  <header class="hero">
    <!-- Carousel Background Slider Layers -->
    <div class="hero-carousel-container">
      <div class="hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1535813547-99c456a41d4a?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80')"></div>
    </div>

    <!-- Dark overlay to ensure text contrast remains excellent -->
    <div class="hero-tint"></div>

    <div class="container hero-content">
      <span class="badge">Industrial Excellence</span>
      <h1>Premium Steel & Metal Distribution</h1>
      <p>Supplying top-grade stainless steel, mild steel, and aluminum products for construction, manufacturing, and hygienic applications.</p>
      <div class="hero-buttons">
        <a href="#products" class="btn btn-primary">View Catalog</a>
        <a href="/contact" class="btn btn-secondary">Request Quote</a>
      </div>
    </div>

    <!-- Interactive Navigation Dots -->
    <div class="carousel-nav">
      <button class="carousel-dot active" data-slide="0" aria-label="Go to slide 1"></button>
      <button class="carousel-dot" data-slide="1" aria-label="Go to slide 2"></button>
      <button class="carousel-dot" data-slide="2" aria-label="Go to slide 3"></button>
      <button class="carousel-dot" data-slide="3" aria-label="Go to slide 4"></button>
    </div>
  </header>

  <!-- Products Catalog Grid Section -->
  <section id="products" class="products-section container">
    <div class="divider2"></div>
    <div class="section-header">
      <h2>Our Core Materials</h2>
      <div class="divider"></div>
      <p>Precision-sourced, carefully tested, and readily loaded for rapid delivery across the UK from our Mold, Flintshire facilities.</p>
    </div>

    <div class="products-grid">
      {products.map((product) => (
        <article class="product-card">
          <div class="card-image-wrapper">
            <Image
              src={product.image}
              alt={product.title}
              width={600}
              height={400}
              loading="lazy"
            />
          </div>
          <div class="card-content">
            <h3>{product.title}</h3>
            <p>{product.description}</p>
            <a href={product.link} class="card-link">
              View Specifications
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 6px;">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
<div class="divider2"></div>
  <!-- Call to Action Section -->
  <section class="cta-section">

    <div class="cta-content container">
      <h2>Need Custom Cutting or Special Processing?</h2>
      <p>Our experienced metal distribution and warehousing facility features advanced sawing, profiling, and bespoke packaging options.</p>
      <a href="/contact" class="btn-light">Contact Our Team</a>
    </div>
  </section>
</Layout>

<!-- Core Carousel Animation Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    let currentIdx = 0;
    const intervalTime = 6000; // Change background slide every 6 seconds
    let carouselTimer: number;

    function showSlide(index: number) {
      // Safe guard against missing elements
      if (slides.length === 0 || dots.length === 0) return;

      // Remove active states
      slides[currentIdx].classList.remove('active');
      dots[currentIdx].classList.remove('active');

      // Update index bound gracefully
      currentIdx = (index + slides.length) % slides.length;

      // Apply active states
      slides[currentIdx].classList.add('active');
      dots[currentIdx].classList.add('active');
    }

    function startTimer() {
      carouselTimer = setInterval(() => {
        showSlide(currentIdx + 1);
      }, intervalTime);
    }

    function resetTimer() {
      clearInterval(carouselTimer);
      startTimer();
    }

    // Attach click triggers to indicator navigation dots
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        showSlide(idx);
        resetTimer();
      });
    });

    // Run carousel rotation loop
    startTimer();
  });
</script>

<style>
  /* --- Carousel Hero Layout Styles --- */
  .hero {
    position: relative;
    height: 650px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--dark); /* Safe fallback base dark color */
  }

  /* Full Bleed Carousel Container */
  .hero-carousel-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s cubic-bezier(0.25, 1, 0.5, 1), visibility 1.2s ease;
    will-change: opacity;
  }

  /* Increased active background visibility to make details highly discernible */
  .hero-slide.active {
    opacity: 0.65; /* Sourced to preserve details clearly */
    visibility: visible;
  }

  /* Lightened dynamic mask using cohesive tints of your custom color palette.
    Replaced heavy solid dark grays with a subtle, professional linear-gradient.
  */
  .hero-tint {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(41, 63, 74, 0.65) 0%,
      rgba(62, 95, 110, 0.25) 100%
    );
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 750px;
    animation: contentReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes contentReveal {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Slider Navigation Dot Elements */
  .carousel-nav {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .carousel-dot {
    width: 24px;
    height: 6px;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    outline: none;
    padding: 0;
  }

  .carousel-dot:hover {
    background-color: rgba(255, 255, 255, 0.50);
  }

  .carousel-dot.active {
    background-color: var(--primary); /* Gold/Brass Accent */
    width: 48px; /* Capsule expansion */
  }

  /* --- Navigation CTA Details --- */
  .hero-buttons {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--primary);
    color: var(--white);
    border: none;
  }

  .btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(198, 170, 130, 0.3);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(4px);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero {
      height: 550px;
    }
    .hero-buttons {
      flex-direction: column;
      gap: 12px;
    }
    .btn {
      width: 100%;
    }
  }
</style>
