---
import '../styles/global.css';
const siteTitle = "Stonehenge Steel UK Ltd";
import SHLogo from '../assets/StoneHenge-Steel-logo-animation-for-website-no-BG.gif';
import Layout from '../layouts/Layout.astro';
---

<html lang="en">
<Layout title="Sheet & Plate">
  <body>
    <!-- Page Header -->
    <header class="page-header">
      <div id="sheet-header-overlay" class="header-overlay"></div>
      <div class="container header-content">
        <h1>Sheet & Plate Products</h1>
        <p>Hot rolled, cold rolled, tread plates, and perforated sheets</p>
      </div>
    </header>

    <!-- Main Content -->
    <main class="content-section container">
      <!-- Return Button -->
      <a href="/#products" class="btn-return">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Products
      </a>

      <div class="spec-grid">

        <!-- Stainless Steel Sheet & Plate -->
        <div class="spec-card highlight-card">
          <h2>Stainless Steel Sheet & Plate</h2>

          <div class="spec-group">
            <h3 class="spec-title">Hot Rolled & Cold Rolled</h3>
            <ul class="spec-list">
              <li><strong>Grades:</strong> 1.4301 (304), 1.4401 (316), 1.4307 (304L), 1.4404 (316L), 1.4845 (310), 1.4016 (430), 1.4003 (3CR12)</li>
              <li><strong>Size Range:</strong> 2000 x 1000mm, 2500 x 1250mm, 3000 x 1500mm, 6000 x 2000mm.</li>
              <li><strong>Finish:</strong> 2B, Dull Polish (DP) 240 grit, Bright Annealed (BA)</li>
              <li><strong>Coating:</strong> Laser Film and poly-coating available on request.</li>
            </ul>
          </div>

          <div class="spec-group">
            <h3 class="spec-title">Tread Plate (Floor / Chequer Plate)</h3>
            <ul class="spec-list">
              <li><strong>Standard:</strong> EN 10088 – 3:2014</li>
              <li><strong>Pattern:</strong> 5 Bar</li>
              <li><strong>Gauges:</strong> 3.0mm, 4.5mm, 6.0mm</li>
              <li><strong>Sizes:</strong> 3000 x 1250mm, 3000 x 1000mm (3mm Gauge Only), 2000 x 1000mm</li>
            </ul>
          </div>

          <div class="spec-group">
            <h3 class="spec-title">Perforated Sheet & Plate</h3>
            <ul class="spec-list">
              <li>Available upon request. Please specify required dimensions.</li>
            </ul>
          </div>
        </div>

        <!-- Mild Steel Sheet & Plate -->
        <div class="spec-card">
          <h2>Mild Steel Sheet & Plate</h2>

          <div class="spec-group">
            <h3 class="spec-title">Standard Plate</h3>
            <ul class="spec-list">
              <li>BS EN 10029 : 1991</li>
              <li>BS EN 10051 : 1992</li>
              <li>BS EN 10025-2 : 2004 – S275JR / S355JR / S355J2</li>
            </ul>
          </div>

          <div class="spec-group">
            <h3 class="spec-title">Sheet Specifications</h3>
            <ul class="spec-list">
              <li><strong>Hot Rolled Sheet:</strong> BS EN 10111 : 1998 DDII (HR4)</li>
              <li><strong>Cold Reduced Sheet:</strong> BS EN 10130 : 1999 DC01</li>
              <li><strong>Galvanised Sheet:</strong> BS EN 10327 : 2005 DX51DZ</li>
            </ul>
          </div>

          <div class="spec-group">
            <h3 class="spec-title">Floor Plate / Tread Plate</h3>
            <ul class="spec-list">
              <li>BS EN 10051 : 1993</li>
              <li>BS EN 10025-2 : 2004 – S275JR</li>
            </ul>
          </div>
        </div>

        <!-- Aluminium Sheet & Plate -->
        <div class="spec-card">
          <h2>Aluminium Sheet & Plate</h2>

          <div class="spec-group">
            <h3 class="spec-title">Aluminium Sheet</h3>
            <ul class="spec-list">
              <li>Alloy 1050A H14/H24</li>
              <li>Alloy 5251 H22</li>
              <li>Alloy 3103 H14</li>
              <li>Alloy 5083 H111</li>
            </ul>
          </div>

          <div class="spec-group">
            <h3 class="spec-title">Aluminium Tread Plate</h3>
            <ul class="spec-list">
              <li><strong>Standard:</strong> BS EN 1386 5 Bar</li>
              <li><strong>Grade:</strong> Alloy 5754 H114</li>
            </ul>
          </div>
        </div>

      </div>
    </main>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container cta-content">
        <h2>Ready to place an order?</h2>
        <p>Contact our sales team to check current stock, pricing, and specific tolerances for our sheet and plate products.</p>
        <a href="/contact" class="btn-light">Contact Sales Team</a>
      </div>
    </section>

  </body>
  </Layout>
</html>

<style>
  /* Local override for the header background image just for this page */
  #sheet-header-overlay {
    background-image: url('https://images.unsplash.com/photo-1563261642-1e967a57a8bf?auto=format&fit=crop&w=1920&q=80');
  }
</style>
