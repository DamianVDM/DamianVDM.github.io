---
import '../styles/global.css';
import { Image } from 'astro:assets';
import SHLogo from '../assets/StoneHenge-Steel-logo-animation-for-website-no-BG.gif';
import SHLogoText from '../assets/Stonehenge-logo.png';
import Layout from '../layouts/Layout.astro';

interface Props {
  title?: string;
  activeTab?: string; // Optional prop to manually force an active tab if needed
}

const { title, activeTab } = Astro.props;
const displayTitle = title || "Premium Metal Products";
const siteTitle = "Stonehenge Steel UK Ltd";



const pathname = Astro.url ? Astro.url.pathname : '';

const isHome = activeTab === 'home' || pathname === '/' || pathname === '/index.astro';
const isGallery = activeTab === 'gallery' || pathname.startsWith('/gallery');
const isContact = activeTab === 'contact' || pathname.startsWith('/contact') || pathname.endsWith('#contact');


const productPaths = ['/bar', '/tube', '/sheet-plate', '/pipe', '/hygienic', '/additional'];
const isProducts = activeTab === 'products' || productPaths.some(path => pathname.startsWith(path)) || (pathname === '/' && activeTab === 'products');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Fixed: Use SHLogo.src as the fallback for favicon since logoGif was undefined -->
    <script type="text/javascript">window.$crisp=[];window.CRISP_WEBSITE_ID="d4ec0e5d-872f-49f8-9816-692c649d41d9";(function(){d=document;s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();</script>
    <link rel="icon" type="image/gif" href={SHLogo.src} />
    <title>{title} | {siteTitle}</title>
  </head>
  <body>

    <!-- Navigation -->
    <nav class="navbar">
      <div class="container nav-content">
        <!-- Logo Links Home -->
        <a href="/" class="logo">
          <Image
            src={SHLogo}
            alt="Stonehenge Logo Animation"
            class="logo-img"
            width={24}
            height={24}
            loading="eager"
          />
          <Image
            src={SHLogoText}
            alt="Stonehenge Steel"
            class="logo-text-img"
            height={20}
            loading="eager"
          />
        </a>
        <ul class="nav-links">
          <li>
            <a href="/" class={isHome && !isProducts ? "active" : ""}>Home</a>
          </li>
          <li>
            <a href="/#products" class={isProducts ? "active" : ""}>Products</a>
          </li>
          <li>
            <a href="/gallery" class={isGallery ? "active" : ""}>Gallery</a>
          </li>
          <li>
            <a href="/#contact" class={isContact ? "active" : ""}>Contact</a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Main Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer id="contact" class="footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <div class="logo">
          <Image
            src={SHLogo}
            alt="Stonehenge Logo Animation"
            class="logo-img"
            width={24}
            height={24}
            loading="lazy"
          />
          <Image
            src={SHLogoText}
            alt="Stonehenge Steel"
            class="logo-text-img"
            height={20}
            loading="lazy"
          />
          </div>
          <p>Your trusted partner in premium metal and steel distribution across all industrial sectors.</p>
        </div>
        <div class="footer-links">
          <h4>Categories</h4>
          <ul>
            <li><a href="/bar">Bar Stock</a></li>
            <li><a href="/tube">Tubes</a></li>
            <li><a href="/sheet-plate">Sheet & Plate</a></li>
            <li><a href="/pipe">Pipes & Fittings</a></li>
            <li><a href="/gallery">Gallery</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Contact Us</h4>
          <p><strong>Email:</strong> sales@stonehengesteel.co.uk</p>
          <p><strong>Phone:</strong> +44 (0) 1352 965 050</p>
          <p><strong>Stonehenge Steel UK Limited</strong><br />
          6 Queens Lane<br />
          Bromfield Industrial Estate<br />
          Mold, Flintshire<br />
          Wales, CH7 1JR</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; 2026 {siteTitle}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
