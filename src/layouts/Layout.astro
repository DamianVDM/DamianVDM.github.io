---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
import logoGif from '../assets/StoneHenge-Steel-logo-animation-for-website-no-BG.gif';

interface Props {
  title?: string;
}

const { title = "Premium Metal Products" } = Astro.props;
const siteTitle = "AeroSteel Distributors";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/gif" href={logoGif.src} />
    <title>{title} | {siteTitle}</title>
  </head>
  <body>
    <!-- Slot for Page Specific Content -->
    <slot />

    <!-- Global Chat Widget (Delayed Apparition) -->
    <ChatWidget />
  </body>
</html>
