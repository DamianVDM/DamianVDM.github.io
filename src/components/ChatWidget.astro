---
// ChatWidget.astro - A self-contained, lightweight global chat widget.
// No external dependencies needed!
---

<!-- Chat Widget Wrapper -->
<div id="global-chat-widget" class="chat-widget-wrapper hidden-widget">

  <!-- Floating Action Button (FAB) -->
  <button id="chat-fab" class="chat-fab-btn" aria-label="Open Chat">
    <span class="notification-badge">1</span>
    <!-- Chat Icon SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <!-- Close Icon SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-close hidden" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Chat Window Window -->
  <div id="chat-window" class="chat-window hidden">
    <!-- Header -->
    <div class="chat-header">
      <div class="rep-avatar">
        <span class="active-dot"></span>
        💬
      </div>
      <div class="rep-info">
        <h4>Sarah Jenkins</h4>
        <p>Stonehenge Sales Representative</p>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="chat-messages" class="chat-messages">
      <div class="message system-msg">
         Sarah joined the conversation.
      </div>
    </div>

    <!-- Input Box -->
    <form id="chat-form" class="chat-input-area">
      <input
        type="text"
        id="chat-input-field"
        placeholder="Type your message here..."
        required
        autocomplete="off"
      />
      <button type="submit" class="send-btn" aria-label="Send Message">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('global-chat-widget');
    const fab = document.getElementById('chat-fab');
    const chatWindow = document.getElementById('chat-window');
    const iconOpen = fab.querySelector('.icon-open');
    const iconClose = fab.querySelector('.icon-close');
    const badge = fab.querySelector('.notification-badge');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input-field');
    const messagesContainer = document.getElementById('chat-messages');

    let chatOpenedOnce = false;
    let initialGreetingSent = false;

    // --- CONFIGURATION ---
    // Change this value to adjust the load delay.
    // E.g., 60000ms = 1 minute. We use 15000ms (15s) for a faster preview!
    const APPARITION_DELAY = 15000;

    // 1. Reveal Widget after a period of time
    setTimeout(() => {
      widget.classList.remove('hidden-widget');
      widget.classList.add('visible-widget');
    }, APPARITION_DELAY);

    // 2. Toggle Chat Window
    fab.addEventListener('click', () => {
      const isHidden = chatWindow.classList.contains('hidden');

      if (isHidden) {
        chatWindow.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        badge.classList.add('hidden'); // Clear the unread badge on open

        // Auto scroll messages
        scrollToBottom();

        // Trigger welcome message if it hasn't fired yet
        if (!initialGreetingSent) {
          initialGreetingSent = true;
          setTimeout(() => {
            sendRepMessage("Hi there! Thanks for visiting Stonehenge Steel. If you need dimensions, stock validation, or specific grade details, I'm here to help!");
          }, 800);
        }
      } else {
        chatWindow.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    // 3. Handle Message Submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      // Add user message to window
      appendMessage('user', text);
      input.value = '';

      // Auto scroll
      scrollToBottom();

      // Trigger automatic contextual sales responses to make it feel alive!
      simulateRepReply(text);
    });

    // Helper: Add custom message element to chat
    function appendMessage(sender, text) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${sender === 'user' ? 'user-msg' : 'rep-msg'}`;

      const speakerName = sender === 'user' ? 'You' : 'Sarah Jenkins';

      msgDiv.innerHTML = `
        <div class="msg-bubble">
          <div class="msg-speaker-wrapper">
            <span class="msg-speaker-bubble">${speakerName}</span>
          </div>
          <p>${text}</p>
        </div>
      `;

      messagesContainer.appendChild(msgDiv);
    }

    function sendRepMessage(text) {
      appendMessage('rep', text);
      scrollToBottom();
    }

    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Dynamic, simulated answers based on user inputs
    function simulateRepReply(userText) {
      const text = userText.toLowerCase();
      let response = "Thanks for your message! If you need specific steel pricing or material processing, your best option is to submit a direct request via our Quote Form, and our technical engineering team will draft a detailed spec sheet for you.";

      if (text.includes('price') || text.includes('cost') || text.includes('quote')) {
        response = "We provide custom volume-based pricing for all bar, tube, and plate products! You can configure your multi-item quote request directly on our Contact page, or let me know what sizes you are looking for here.";
      } else if (text.includes('stainless') || text.includes('grade') || text.includes('304') || text.includes('316')) {
        response = "We supply top-grade 1.4307 (304L) and 1.4404 (316L) stainless steel across our entire bar, tube, pipe, and plate inventory. Are you looking for raw decorative stock or structural sections?";
      } else if (text.includes('delivery') || text.includes('stock') || text.includes('available')) {
        response = "Most standard sizes are in stock at Stonehenge Steel UK and can be dispatched for rapid transit or collected immediately from our Mold, Flintshire site.";
      }

      // Show typing indicator
      const typingIndicator = document.createElement('div');
      typingIndicator.className = 'message rep-msg typing-indicator-wrapper';
      typingIndicator.innerHTML = `
        <div class="msg-bubble typing-bubble">
          <div class="msg-speaker-wrapper">
            <span class="msg-speaker-bubble">Sarah Jenkins</span>
          </div>
          <div class="typing-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
        </div>
      `;
      messagesContainer.appendChild(typingIndicator);
      scrollToBottom();

      // Send simulated response after 1.5 - 2.5s delay
      setTimeout(() => {
        typingIndicator.remove();
        sendRepMessage(response);
      }, 2000);
    }
  });
</script>

<style>
  /* --- Local Scoped CSS Styles for Chat Widget --- */
  .chat-widget-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: system-ui, -apple-system, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }

  .hidden-widget {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    pointer-events: none;
  }

  .visible-widget {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* --- Floating Action Button --- */
  .chat-fab-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #0284c7; /* Brand Primary */
    color: #ffffff;
    border: none;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .chat-fab-btn:hover {
    background-color: #0369a1;
    transform: scale(1.05);
    box-shadow: 0 15px 30px -5px rgba(2, 132, 199, 0.6);
  }

  .chat-fab-btn:active {
    transform: scale(0.95);
  }

  /* Unread Notification Badge */
  .notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background-color: #ef4444; /* Alert Red */
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    animation: pulseBadge 2s infinite;
  }

  @keyframes pulseBadge {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }

  /* --- Chat Box Window --- */
  .chat-window {
    width: 380px;
    height: 480px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.3);
    border: 1px solid #e2e8f0;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: popUpWindow 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes popUpWindow {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Chat Header */
  .chat-header {
    background-color: #0f172a; /* Slate 900 */
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid #1e293b;
  }

  .rep-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    position: relative;
    border: 1.5px solid #0284c7;
  }

  .active-dot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 11px;
    height: 11px;
    background-color: #10b981; /* Green status dot */
    border-radius: 50%;
    border: 2px solid #0f172a;
  }

  .rep-info h4 {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
  }

  .rep-info p {
    color: #94a3b8;
    font-size: 0.75rem;
    margin: 2px 0 0 0;
  }

  /* Chat Log messages area */
  .chat-messages {
    flex-grow: 1;
    padding: 20px;
    overflow-y: auto;
    background-color: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .message {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }

  .user-msg {
    align-self: flex-end;
  }

  .rep-msg {
    align-self: flex-start;
  }

  .system-msg {
    align-self: center;
    max-width: 100%;
    text-align: center;
    font-size: 0.75rem;
    color: #64748b;
    background-color: #e2e8f0;
    padding: 4px 12px;
    border-radius: 12px;
  }

  /* Speaker label headers inside the bubble */
  .msg-speaker-wrapper {
    margin-bottom: 6px;
    display: flex;
  }

  .user-msg .msg-speaker-wrapper {
    justify-content: flex-end;
  }

  .rep-msg .msg-speaker-wrapper {
    justify-content: flex-start;
  }

  .msg-speaker-bubble {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 12px;
    display: inline-block;
  }

  .user-msg .msg-speaker-bubble {
    background-color: rgba(255, 255, 255, 0.25); /* Translucent white bubble for dark primary background */
    color: #ffffff;
  }

  .rep-msg .msg-speaker-bubble {
    background-color: #f1f5f9; /* Light slate bubble */
    color: #475569;
  }

  /* Msg Bubble formatting */
  .msg-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.875rem;
    line-height: 1.45;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .msg-bubble p {
    margin: 0;
    word-break: break-word;
    white-space: pre-wrap;
  }

  .user-msg .msg-bubble {
    background-color: #0284c7;
    color: #ffffff;
    border-top-right-radius: 2px;
  }

  .rep-msg .msg-bubble {
    background-color: #ffffff;
    color: #334155;
    border-top-left-radius: 2px;
    border: 1px solid #e2e8f0;
  }

  /* Chat Inputs Box */
  .chat-input-area {
    padding: 16px 20px;
    border-top: 1px solid #e2e8f0;
    background-color: #ffffff;
    display: flex;
    gap: 10px;
  }

  .chat-input-area input {
    flex-grow: 1;
    border: 1px solid #cbd5e1;
    border-radius: 24px;
    padding: 10px 18px;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .chat-input-area input:focus {
    border-color: #0284c7;
  }

  .send-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #0284c7;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .send-btn:hover {
    background-color: #0284c7;
    color: #ffffff;
  }

  /* Typing Indicator Simulation CSS */
  .typing-bubble {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .typing-dots {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 2px;
  }

  .typing-dots .dot {
    width: 6px;
    height: 6px;
    background-color: #94a3b8;
    border-radius: 50%;
    animation: bounceDot 1.4s infinite ease-in-out both;
  }

  .typing-dots .dot:nth-child(1) { animation-delay: -0.32s; }
  .typing-dots .dot:nth-child(2) { animation-delay: -0.16s; }

  @keyframes bounceDot {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
  }

  /* Helper Classes */
  .hidden {
    display: none !important;
  }

  /* Responsive Design fixes */
  @media (max-width: 480px) {
    .chat-window {
      width: calc(100vw - 32px);
      height: 400px;
    }
  }
</style>
